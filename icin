<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Гексаграмма</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f4f1ea 0%, #e4e9e2 100%);
      font-family: 'Segoe UI', Tahoma, sans-serif;
      color: #3a3a36;
      padding: 20px;
      box-sizing: border-box;
    }
    .card {
      background: #fff;
      border-radius: 24px;
      padding: 40px 44px;
      text-align: center;
      max-width: 480px;
      box-shadow: 0 10px 40px rgba(60, 60, 40, 0.12);
    }
    .lines { margin: 0 auto 18px; width: 200px; }
    .lines div { height: 12px; margin: 9px 0; background: #3a3a36; border-radius: 6px; display: flex; justify-content: space-between; }
    .lines div span { width: 44%; background: #3a3a36; border-radius: 6px; }
    .num { font-size: 14px; letter-spacing: 2px; color: #8a8578; margin-bottom: 6px; }
    .name { font-size: 22px; font-weight: 600; margin-bottom: 12px; }
    p { font-size: 18px; line-height: 1.7; margin: 0; }
    .hint { margin-top: 20px; font-size: 13px; color: #a09a8c; }
  </style>
</head>
<body>
  <div class="card">
    <div class="lines" id="lines"></div>
    <div class="num" id="num"></div>
    <div class="name" id="name"></div>
    <p id="text"></p>
    <div class="hint">обнови страницу — выпадет другая</div>
  </div>

  <script>
    const hexagrams = [
      { n: 1,  b: "111111", name: "Цянь — Творчество",            text: "Сильная жизненная энергия. Время действовать смело и честно — но без суеты." },
      { n: 2,  b: "000000", name: "Кунь — Исполнение",           text: "Мягкость и терпение сильнее напора. Сейчас побеждает тот, кто умеет принять." },
      { n: 3,  b: "100010", name: "Чжунь — Трудное начало",      text: "Начало всегда хаотично. Не бросай на старте — именно сейчас зарождается главное." },
      { n: 4,  b: "010001", name: "Мэн — Юношество",             text: "Не стыдно не знать. Стыдно не спрашивать. Будь учеником — и путь откроется." },
      { n: 5,  b: "111010", name: "Сюй — Ожидание",              text: "Пауза — не потеря времени. Иди вглубь, пока дорога ещё не видна до конца." },
      { n: 6,  b: "010111", name: "Сун — Суд",                   text: "Спор не brings победы обоим. Уступи в мелочи — сохрани главное." },
      { n: 7,  b: "010000", name: "Ши — Войско",                 text: "Порядок и дисциплина решают. Действуй по плану, а не по эмоции." },
      { n: 8,  b: "000010", name: "Би — Приближение",            text: "Хорошая компания важнее быстрой победы. Держись тех, кто тебе дорог." },
      { n: 9,  b: "111011", name: "Сяо Чу — Малое воспитание",   text: "Мелкие шаги сейчас сильнее рывка. Укрепляй то, что уже есть." },
      { n: 10, b: "110111", name: "Ли — Наступление",            text: "Иди вперёд осторожно, как по хвосту тигра: смело, но внимательно." },
      { n: 11, b: "111000", name: "Тай — Расцвет",               text: "Всё складывается само. Наслаждайся моментом — и не забудь его потом." },
      { n: 12, b: "000111", name: "Пи — Упадок",                 text: "Не всё от тебя зависит. Сохрани себя и подожди — полоса сменится." },
      { n: 13, b: "101111", name: "Тун Жэнь — Единомышленники",  text: "Найди своих. Вместе даже сложный путь становится простым." },
      { n: 14, b: "111101", name: "Да Ю — Великое обладание",    text: "У тебя есть ресурсы и свет. Пользуйся ими щедро, не жадничая." },
      { n: 15, b: "001000", name: "Цянь — Смирение",             text: "Тихая уверенность звучит громче громких слов. Будь скромен — и заметен." },
      { n: 16, b: "000100", name: "Юй — Вольность",              text: "Радость без причины — уже праздник. Разреши себе немного лёгкости." },
      { n: 17, b: "100110", name: "Суй — Последование",          text: "Умей следовать за тем, кому доверяешь. Это не слабость, а мудрость." },
      { n: 18, b: "011001", name: "Гу — Исправление",            text: "Что-то давно просят ремонта. Почини — и станет легче дышать." },
      { n: 19, b: "110000", name: "Линь — Посещение",            text: "Твоё время приближается. Готовься заранее, чтобы не споткнуться." },
      { n: 20, b: "000011", name: "Гуань — Созерцание",          text: "Остановись и посмотри со стороны. Ответ виден тому, кто не спешит." },
      { n: 21, b: "100101", name: "Ши Хэ — Стиснутые зубы",      text: "Препятствие можно прогрызть. Настойчивость сейчас — твой главный инструмент." },
      { n: 22, b: "101001", name: "Би — Изящество",              text: "Красота деталей меняет целое. Добавь в день немного изящества." },
      { n: 23, b: "000001", name: "Бо — Разрушение",             text: "Старое осыпается. Не жалей — на чистом месте вырастет новое." },
      { n: 24, b: "100000", name: "Фу — Возврат",               text: "Точка поворота. То, что казалось потерянным, возвращается." },
      { n: 25, b: "100111", name: "У Ван — Невинность",          text: "Действуй просто и честно, без хитростей. Так получится лучше всего." },
      { n: 26, b: "111001", name: "Да Чу — Накопление",          text: "Собирай силу тихо. Большое дело требует большой внутренней кладовой." },
      { n: 27, b: "100001", name: "И — Питание",                 text: "Следи за тем, чем питаешься: едой, словами, мыслями. Это формирует тебя." },
      { n: 28, b: "011110", name: "Да Го — Перевес",             text: "Нагрузка велика, но не致命на. Справишься — если не тащишь всё в одиночку." },
      { n: 29, b: "010010", name: "Кань — Опасность",            text: "Вода принимает форму берегов. Прими обстоятельства — и пройдешь их." },
      { n: 30, b: "101101", name: "Ли — Сияние",                 text: "Свет нужен и снаружи, и внутри. Держи своё пламя аккуратно." },
      { n: 31, b: "001110", name: "Сянь — Влияние",              text: "Чувства важнее расчёта. Прислушайся к тому, что тянет тебя само." },
      { n: 32, b: "011100", name: "Хэн — Постоянство",           text: "Маленькое, но каждый день — сильнее редкого подвига." },
      { n: 33, b: "001111", name: "Дунь — Отступление",          text: "Умение вовремя уйти — тоже движение вперёд." },
      { n: 34, b: "111100", name: "Да Чжуан — Великая мощь",     text: "Сила есть. Используй её по-честному, иначе она станет против тебя." },
      { n: 35, b: "000101", name: "Цзинь — Подъём",              text: "Тебя замечают. Расти спокойно — признание уже на пути." },
      { n: 36, b: "101000", name: "Мин И — Скрытый свет",        text: "Свет внутри не обязан светить наружу. Храни его при себе." },
      { n: 37, b: "101011", name: "Цзя Жэнь — Семья",            text: "Тепло начинается дома. Уделить внимание своим — лучшая инвестиция дня." },
      { n: 38, b: "110101", name: "Куй — Разлад",                text: "Разногласия — не катастрофа. Иногда противоположности дополняют друг друга." },
      { n: 39, b: "001010", name: "Цзянь — Препятствие",         text: "Дорога закрыта — это не значит, что её нет. Обойди." },
      { n: 40, b: "010100", name: "Цзе — Освобождение",          text: "Груз можно снять. Прости, отпусти, выдохни." },
      { n: 41, b: "110001", name: "Сунь — Убыль",                text: "Меньше — иногда больше. Откажись от лишнего без сожаления." },
      { n: 42, b: "100011", name: "И — Приумножение",            text: "Ветер и гром усиливают друг друга. Делись — и получишь вдвойне." },
      { n: 43, b: "111110", name: "Гуай — Решимость",            text: "Настал момент сказать твёрдое «да» или твёрдое «нет». Половинчатость худший вариант." },
      { n: 44, b: "011111", name: "Гоу — Встреча",               text: "Незваное приходит само. Прими спокойно, но не теряй себя." },
      { n: 45, b: "000110", name: "Цуй — Собрание",              text: "Люди собираются вокруг тепла. Будь тем, к чему хочется подойти." },
      { n: 46, b: "011000", name: "Шэн — Восхождение",           text: "Дерево растёт медленно и неотвратимо. Твой подъём уже идёт." },
      { n: 47, b: "010110", name: "Кунь — Истощение",            text: "Тяжёлый этап. Но именно в трудное время видно, кто ты." },
      { n: 48, b: "011010", name: "Цзин — Колодец",              text: "Источник внутри не иссякает, сколько бы ни черпали. Иди к нему." },
      { n: 49, b: "101110", name: "Гэ — Обновление",             text: "Смена нужна. Сними старую кожу — не бойся, под ней ты." },
      { n: 50, b: "011101", name: "Дин — Жертвенник",            text: "Займись тем, что «кормит» твою душу. Кухня жизни — важное место." },
      { n: 51, b: "100100", name: "Чжэнь — Гром",                text: "Встряска — не катастрофа, а звонок: пора проснуться." },
      { n: 52, b: "001001", name: "Гэнь — Сосредоточенность",    text: "Неподвижность — это тоже действие. Остановись, услышь себя." },
      { n: 53, b: "001011", name: "Цзянь — Постепенность",       text: "Медленное развитие устойчивее быстрого. Не пропускай ступени." },
      { n: 54, b: "110100", name: "Гуй Мэй — Союз",              text: "Прими свою роль с достоинством — и место займёшь своё." },
      { n: 55, b: "101100", name: "Фэн — Изобилие",              text: "Полдень жизни: пользуйся светом, пока он в зените." },
      { n: 56, b: "001101", name: "Люй — Странствие",            text: "Оказаться среди чужих — не беда. Скромность и вежливость открывают двери." },
      { n: 57, b: "011011", name: "Сюнь — Проникновение",         text: "Мягкий ветер меняет камни. Действуй тихо и настойчиво." },
      { n: 58, b: "110110", name: "Дуй — Радость",               text: "Радость — это выбор. Сделай его сегодня." },
      { n: 59, b: "010011", name: "Хуань — Развеивание",         text: "Лёд тает, когда приходит тепло. Разреши себе растаять." },
      { n: 60, b: "110010", name: "Цзе — Ограничение",           text: "Границы не ломают свободу — они её сохраняют." },
      { n: 61, b: "110011", name: "Чжун Фу — Искренность",       text: "Внутренняя правда сильнее внешних слов. Будь честен с собой." },
      { n: 62, b: "001100", name: "Сяо Го — Малый перевес",      text: "Сейчас лучше перелететь чуть-чуть, чем сильно перебрать." },
      { n: 63, b: "101010", name: "Цзи Цзи — Завершённость",     text: "Дело сделано. Не расслабляйся: за пиком всегда начинается спуск — и новый подъём." },
      { n: 64, b: "010101", name: "Вэй Цзи — Ещё не конец",      text: "Финал близко, но не наступил. Осторожные последние шаги важнее первых." }
    ];

    const h = hexagrams[Math.floor(Math.random() * hexagrams.length)];

    document.getElementById('num').textContent  = 'Гексаграмма № ' + h.n;
    document.getElementById('name').textContent = h.name;
    document.getElementById('text').textContent = h.text;

    const box = document.getElementById('lines');
    for (const c of h.b) {
      const row = document.createElement('div');
      if (c === '0') { const s1 = document.createElement('span'); const s2 = document.createElement('span'); row.appendChild(s1); row.appendChild(s2); }
      box.appendChild(row);
    }
  </script>
</body>
</html>
